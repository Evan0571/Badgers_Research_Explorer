{
  "name": "uw-research-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src next.config.ts tsconfig.json vitest.config.ts package.json",
    "check:config": "tsx scripts/check-config.ts",
    "probe:sources": "tsx scripts/source-probe.ts",
    "catalog:seed": "tsx scripts/catalog-campus.ts",
    "catalog:departments": "tsx scripts/catalog-seed.ts",
    "catalog:campus": "tsx scripts/catalog-campus.ts",
    "catalog:contacts": "tsx scripts/catalog-contacts.ts",
    "catalog:refresh": "tsx scripts/catalog-refresh.ts",
    "catalog:verify": "tsx scripts/catalog-verify.ts",
    "catalog:sync": "tsx scripts/catalog-sync.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.3.0",
    "mammoth": "^1.12.3",
    "next": "^16.3.6",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.21",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  }
}
