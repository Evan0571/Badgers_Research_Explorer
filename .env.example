# Copy to .env.local in this worktree. Never commit real values.
APP_ORIGIN=http://127.0.0.1:3002
DATABASE_PATH=.data/research.sqlite

# Responses API, with web_search enabled on your project/model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up alongside the database. Changing it invalidates stored message snapshots and verification codes.
APP_ENCRYPTION_KEY=

# UW email verification. Use a sender on a verified Resend domain.
RESEND_API_KEY=
VERIFICATION_FROM=

# Optional platform sender. Leave blank until the sending method is chosen.
# Enabling Resend sends from MAIL_FROM with Reply-To set to the verified UW email.
MAIL_TRANSPORT=
MAIL_FROM=
