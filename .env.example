# Copy to .env.local in this worktree. Never commit real values.
APP_ORIGIN=http://127.0.0.1:3002
DATABASE_PATH=.data/research.sqlite

# Responses API, with web_search enabled on your project/model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back this up alongside the database. Changing it invalidates stored messages, Outlook tokens, and verification codes.
APP_ENCRYPTION_KEY=

# UW email verification. Use a sender on a verified Resend domain.
RESEND_API_KEY=
VERIFICATION_FROM=

# Microsoft Entra Web app registration. Delegated User.Read and Mail.Send.
# Tokens stay encrypted on the server; Resend is used only for verification codes.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=organizations
# Register APP_ORIGIN + /api/outlook/callback as a Web redirect URI.
